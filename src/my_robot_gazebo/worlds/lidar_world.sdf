<?xml version="1.0"?>


<!-- The Sensor system is necessary for Gazebo Harmonic to -->
<!-- generate GPU LiDAR measurements-->


<sdf version="1.9">
    <world name="lidar_world">

        <!-- Physics-->
        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics" />

        <!-- Model spawning-->
        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands" />

        <!-- Gazebo visualisation-->
        <plugin 
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
        
        <!-- Enable LiDAR simulation-->
        <plugin 
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

                
        <!-- Enable IMU simulation-->
        <plugin 
            filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu" />
            
        <gravity>0 0 -9.8</gravity>

        <!-- Lighting-->
        <light name="sun" type="directional">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0 -1</direction>
        </light>
        
        <!-- Ground-->
        <model name="ground_plane">
            <static>true</static>

            <link name="ground">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>20 20</size>
                        </plane>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>20 20</size>
                        </plane>
                    </geometry>
                </visual>
            </link>
        </model>

        <!-- Obstacle-->
        <model name="obstacle">
            <static>true</static>
            <pose>2 0 0.5 0 0 0</pose>

            <link name="box">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.5 1.0 1.0</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.5 1.0 1.0</size>
                        </box>
                    </geometry>
                </visual>
            </link>
        </model>

        <!-- North wall-->
        <model name="north_wall">
            <static>true</static>
            <pose>0 3 0.5 0 0 0</pose>
            <link name="wall_link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>8 0.2 1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>8 0.2 1</size>
                        </box>
                    </geometry>
                </visual>
            </link>
        </model>

        <!-- South wall-->
        <model name="south_wall">
            <static>true</static>
            <pose>0 -3 0.5 0 0 0</pose>
            <link name="wall_link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>8 0.2 1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>8 0.2 1</size>
                        </box>
                    </geometry>
                </visual>
            </link>
        </model>

        <!-- East wall-->
        <model name="east_wall">
            <static>true</static>
            <pose>4 0 0.5 0 0 0</pose>
            <link name="wall_link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.2 6 1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.2 6 1</size>
                        </box>
                    </geometry>
                </visual>
            </link>
        </model>

        <!-- West wall-->
        <model name="west_wall">
            <static>true</static>
            <pose>-4 0 0.5 0 0 0</pose>
            <link name="wall_link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.2 6 1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.2 6 1</size>
                        </box>
                    </geometry>
                </visual>
            </link>
        </model>
    </world>
</sdf>