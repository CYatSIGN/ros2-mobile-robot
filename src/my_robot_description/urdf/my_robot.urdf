<?xml version="1.0"?>

<!-- Define robot structu.re within this -->
<robot name="my_robot">

    <material name="grey">
        <color rgba="0.7 0.7 0.7 1" />
    </material>

    <material name="green">
        <color rgba="0 0.6 0 1" />
    </material>

    <material name="white">
        <color rgba="1 1 1 1" />
    </material>

    <!-- <link name="base_footprint">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.001"/>
            <inertia
                ixx="0.000001"
                ixy="0"
                ixz="0"
                iyy="0.000001"
                iyz="0"
                izz="0.000001"/>
        </inertial>
    </link> -->

    <link name="base_link">
        <visual>
            <!-- Define the geometry of the base -->
            <geometry>
                <!-- l, w, h-->
                <box size="0.6 0.4 0.2" />
            </geometry>
            <!-- coodinates:xyz; rotation:raw, pitch, yaw-->
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="green" />
        </visual>
        <collision>
            <geometry>
                <box size="0.6 0.4 0.2" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <!-- Represents a 5kg rectangular chassis with dimensions 0.6x0.4x0.2m-->
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="5.0" />
            <inertia
                ixx="0.083333"
                ixy="0"
                ixz="0"
                iyy="0.166667"
                iyz="0"
                izz="0.216667" />
        </inertial>
    </link>

    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="white" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.1" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.2" /> 
            <inertia
                ixx="0.00054167"
                ixy="0"
                ixz="0"
                iyy="0.00054167"
                iyz="0"
                izz="0.001" /> 
        </inertial>
    </link>

    <link name="left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.1" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />     
        </collision>
        <!-- Each wheel has mass of 0.5kg-->
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.5" />
            <inertia
                ixx="0.00135417"
                ixy="0"
                ixz="0"
                iyy="0.0025"
                iyz="0"
                izz="0.00135417" />
        </inertial>
    </link>

    <link name="right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.1" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.5" />
            <inertia
                ixx="0.00135417"
                ixy="0"
                ixz="0"
                iyy="0.0025"
                iyz="0"
                izz="0.00135417" />
        </inertial>
    </link>

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.1" />
            <inertia
                ixx="0.0001"
                ixy="0"
                ixz="0"
                iyy="0.0001"
                iyz="0"
                izz="0.0001" />
        </inertial>
    </link>

    <!-- Create a relationship between the base and lidar-->
    <!-- <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0.2" rpy="0 0 0" />
    </joint> -->

    <joint name="base_lidar_joint" type="fixed">
        <parent link="base_link" />
        <child link="lidar_link" />
        <origin xyz="0 0 0.125" rpy="0 0 0" />
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel_link" />
        <origin xyz="-0.15 0.225 -0.1" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel_link" />
        <origin xyz="-0.15 -0.225 -0.1" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link" />
        <origin xyz="0.2 0 -0.15" rpy="0 0 0" />
    </joint>

    <!-- Gazebo differential-drive controller-->
    <!-- Gazebo DiffDrive system controls the wheel joints-->
    <!-- and calculates odometry from the command motion-->
    <gazebo>
        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
        
            <!-- Wheel joints-->
            <left_joint>base_left_wheel_joint</left_joint>
            <right_joint>base_right_wheel_joint</right_joint>

            <!-- Wheel dimensions-->
            <wheel_separation>0.45</wheel_separation>
            <wheel_radius>0.1</wheel_radius>

            <!-- Velocity command topic-->
            <topic>/cmd_vel</topic>

            <!-- Odometry-->
            <odom_topic>/odom</odom_topic>
            <odom_publish_frequency>30</odom_publish_frequency>

            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
           
        </plugin>
        
    </gazebo>

    <!-- Gazebo LiDAR sensor-->
    <!-- Configures a 360deg LiDAR with a 10-metre maximum range-->
    <!-- producing 360 measurements per scan at 10Hz-->
    <gazebo reference="lidar_link">
        <sensor name="lidar_sensor" type="gpu_lidar">

            <always_on>true</always_on>
            <update_rate>10</update_rate>
            <visualize>true</visualize>

            <topic>/scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>

            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>

                <range>
                    <min>0.1</min>
                    <max>10.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
        </sensor>

    </gazebo>

    <!-- IMU link-->
    <link name="imu_link">
        <inertial>
            <mass value="0.05" />
            <inertia
                ixx="0.00001"
                ixy="0"
                ixz="0"
                iyy="0.00001"
                iyz="0"
                izz="0.00001" />
        </inertial>
    </link>

    <!-- Attach IMU to the robot chassis-->
    <joint name="imu_joint" type="fixed">
        <parent link="base_link" />
        <child link="imu_link" />
        <!-- Places the IMU at the centre of the chassis-->
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!-- Gazebo IMU sensor-->
    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <!-- Configure the IMU to publish at 100Hz-->
            <always_on>true</always_on>
            <update_rate>100</update_rate>

            <topic>/imu/data</topic>
            <gz_frame_id>imu_link</gz_frame_id>

            <imu>
                <orientation_reference_frame>
                    <localization>ENU</localization>
                </orientation_reference_frame>
            </imu>

        </sensor>
    </gazebo>

    <!-- Gazebo joint state publisher-->
    <gazebo>
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">

            <topic>/joint_states</topic>

            <joint_name>base_left_wheel_joint</joint_name>
            <joint_name>base_right_wheel_joint</joint_name>

        </plugin>
    </gazebo>
    
</robot>
<!-- Define robot structure within this --> 